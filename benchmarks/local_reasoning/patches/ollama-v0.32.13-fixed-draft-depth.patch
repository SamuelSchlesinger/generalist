+func TestDepthControllerFixedDepthOverride(t *testing.T) {
+	t.Setenv("OLLAMA_MLX_FIXED_DRAFT_DEPTH", "5")
+	c := newDepthController()
+	if c.scheduled != 5 {
+		t.Fatalf("initial scheduled depth = %d, want 5", c.scheduled)
+	}
+	for range 20 {
+		if got := c.next(); got != 5 {
+			t.Fatalf("fixed next depth = %d, want 5", got)
+		}
+		c.cost.observe(5, 10*time.Millisecond)
+		c.acc.observe(5, 0)
+	}
+	if got := c.next(); got != 5 {
+		t.Fatalf("acceptance data changed fixed depth to %d, want 5", got)
+	}
+
+	c.drafterLimit = 3
+	if got := c.next(); got != 3 {
+		t.Fatalf("fixed depth ignored drafter limit: got %d, want 3", got)
+	}
+}
+
+func TestDepthControllerInvalidFixedDepthFallsBackToAdaptive(t *testing.T) {
+	t.Setenv("OLLAMA_MLX_FIXED_DRAFT_DEPTH", "not-a-depth")
+	c := newDepthController()
+	if c.fixed != -1 {
+		t.Fatalf("invalid override selected fixed depth %d", c.fixed)
+	}
+	if got := c.next(); got != 0 {
+		t.Fatalf("adaptive warmup started at depth %d, want 0", got)
+	}
+}
